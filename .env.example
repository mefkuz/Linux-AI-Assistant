# Remote LLM Konfigürasyonu (Örn: OpenAI, Anthropic vb. uyumlu API'ler için)
REMOTE_LLM_API_KEY=your_api_key_here
REMOTE_LLM_API_URL=https://api.openai.com/v1/chat/completions
REMOTE_LLM_MODEL=gpt-4

# Yerel LLM Konfigürasyonu (Örn: Llama.cpp, Ollama veya LM Studio vb.)
# Llama.cpp / Ollama genellikle localhost:8080 veya localhost:11434 kullanır
LOCAL_LLM_API_URL=http://localhost:8080/v1/chat/completions
LOCAL_LLM_MODEL=local-model

# Varsayılan mod (local veya remote)
DEFAULT_LLM_MODE=local
